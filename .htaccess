<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and WWW
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.dallasblacklimoservice\.com$ [NC]
RewriteRule ^(.*)$ https://www.dallasblacklimoservice.com/$1 [R=301,L]

# Remove index.php from URL
RewriteCond %{THE_REQUEST} \s/+index\.php[?\s] [NC]
RewriteRule ^index\.php$ https://www.dallasblacklimoservice.com/ [R=301,L]

# Redirect assets to public folder
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^css/(.*)$ public/css/$1 [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^js/(.*)$ public/js/$1 [L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^images/(.*)$ public/images/$1 [L]

# Remove multiple slashes in URL
RewriteCond %{THE_REQUEST} \s/+(.+)//+([^\s]*) [NC]
RewriteRule .* /%1/%2 [R=301,L]


# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# Long-cache static assets for mobile repeat visits
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|webp|jpg|jpeg|png|gif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>